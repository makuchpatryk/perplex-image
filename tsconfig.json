{
  // https://nuxt.com/docs/guide/concepts/typescript
  "extends": "./.nuxt/tsconfig.json",
  "include": ["types/*.d.ts"],
  "compilerOptions": {
    "lib": ["es5", "es6", "dom", "dom.iterable"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "paths": {
      "~/*": ["./*"],
      "~core/*": ["./modules/core/*"],
      "~ui/*": ["./modules/ui/*"],
      "~game/*": ["./modules/game/*"],
      "@core/*": ["./modules/core/*"],
      "@ui/*": ["./modules/ui/*"],
      "@game/*": ["./modules/game/*"],
      "#imports": ["./types/nuxt-icon.d.ts"]
    }
  }
}
