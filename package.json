{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "lint": "pnpm lint:eslint",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier . --check",
    "lintfix": "eslint . --fix && prettier --write --list-different .",
    "preview": "nuxt preview",
    "start": "nuxt start",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "typecheck": "nuxt typecheck && tsc --noEmit --project tsconfig.json",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "upload:images": "tsx scripts/uploadImages/upload.ts",
    "reinstall": "rm -rf node_modules pnpm-lock.yaml && pnpm install"
  },
  "lint-staged": {
    "modules/**/*.{ts,vue}": "pnpm lint"
  },
  "devDependencies": {
    "@nuxt/eslint": "^0.7.1",
    "@nuxtjs/eslint-config-typescript": "^12.0.0",
    "@nuxtjs/i18n": "^10.4.0",
    "@nuxtjs/tailwindcss": "^6.2.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.12.2",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-vue": "^4.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.3",
    "@vue/test-utils": "^2.2.6",
    "@vueuse/components": "^11.1.0",
    "@vueuse/nuxt": "^11.1.0",
    "chai": "^6.2.2",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-vitest": "^0.0.21",
    "eslint-plugin-vue": "^9.30.0",
    "husky": "^9.1.6",
    "jsdom": "^20.0.3",
    "lint-staged": "^15.2.10",
    "nuxt": "3.12.4",
    "nuxt-icon": "^0.6.10",
    "prettier": "^2.8.8",
    "sharp": "^0.34.5",
    "tinyspy": "^4.0.4",
    "tsx": "^4.17.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.4.6",
    "@supabase/supabase-js": "^2.106.1",
    "@vueuse/core": "^11.1.0",
    "dotenv": "^16.4.7",
    "pinia": "^2.1.7",
    "unhead": "^2.1.11",
    "uuid": "^9.0.1",
    "vue": "^3.4.15"
  }
}
